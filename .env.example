# ============================================
# Vetalis Healthcare Management System
# Environment Variables Configuration
# ============================================
# Copy this file to .env.local and fill in your values:
# cp .env.example .env.local

# --------------------------------------------
# Supabase Configuration
# --------------------------------------------
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable / Anon Key (Safe for client-side use)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key

# Supabase Storage & Region (Optional)
NEXT_PUBLIC_SUPABASE_STORAGE_URL=https://your-project-id.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_REGION=us-east-1
NEXT_PUBLIC_SUPABASE_REGION=us-east-1

# Optional Database Direct Connection (For migrations / CLI)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres

# --------------------------------------------
# Google OAuth Credentials
# --------------------------------------------
# Obtained from Google Cloud Console (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --------------------------------------------
# AI / LLM Provider Configuration
# --------------------------------------------
# Supports Google Gemini API, OpenCode Zen, OpenAI, or any OpenAI-compatible proxy
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_API_KEY=your-ai-api-key
AI_MODEL_NAME=gemini-1.5-flash

# Legacy Aliases (Optional fallback for Gemini)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL_NAME=gemini-1.5-flash

# --------------------------------------------
# OCR Configuration (Optional for Report Text Extraction)
# --------------------------------------------
# Free tier key available at https://ocr.space/ocrapi
OCR_SPACE_API_KEY=helloworld
