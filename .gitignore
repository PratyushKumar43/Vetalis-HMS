.env
.env.*
*.env
!.env.example

# Certificates & Private Keys
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.id_rsa
*.id_dsa
secring.gpg

# Next.js Build Outputs
/.next/
/out/
/build
/dist

# Testing & Coverage
/coverage
*.lcov
.nyc_output

# Debug & Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Vercel & Deployment
.vercel
.turbo
.serverless/

# Supabase Local Cache
supabase/.temp/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDEs and Editors
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

